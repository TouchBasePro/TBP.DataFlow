FROM node:22-bookworm-slim AS ui-build

RUN apt-get update \
    && apt-get install --no-install-recommends --yes git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /source

COPY ui/package.json ui/package-lock.json ui/
WORKDIR /source/ui
RUN npm ci

WORKDIR /source
COPY ui ui
COPY webserver webserver
COPY .git .git

WORKDIR /source/ui
RUN npm run build

FROM kestra/kestra:v1.3.32

USER root

COPY --from=ui-build --chown=kestra:kestra /source/webserver/src/main/resources/ui /tmp/tbp-ui
COPY --from=ui-build --chown=kestra:kestra /source/ui/src/assets/logo.svg /tmp/tbp-logo.svg

RUN apt-get update \
    && apt-get install --no-install-recommends --yes zip unzip \
    && mkdir /tmp/kestra-ui \
    && cd /tmp/kestra-ui \
    && unzip -q /app/kestra \
    && rm -rf ui \
    && cp -R /tmp/tbp-ui ui \
    && cp /tmp/tbp-ui/favicon.ico root/favicon.ico \
    && cp /tmp/tbp-ui/favicon-192x192.png static/favicon.png \
    && cp /tmp/tbp-logo.svg static/logo.svg \
    && mv /app/kestra /app/kestra.zip \
    && zip -q -r /app/kestra.zip ui root static \
    && mv /app/kestra.zip /app/kestra \
    && chmod +x /app/kestra \
    && chown kestra:kestra /app/kestra \
    && rm -rf /tmp/kestra-ui /tmp/tbp-ui /tmp/tbp-logo.svg /var/lib/apt/lists/*

USER kestra